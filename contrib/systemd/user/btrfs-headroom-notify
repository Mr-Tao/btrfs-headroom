#!/bin/sh
# SPDX-License-Identifier: Apache-2.0 OR MIT

set -eu

status_file=${1:-/run/btrfs-headroom/status.json}
runtime_dir=${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}
state_dir=$runtime_dir/btrfs-headroom-notify
state_file=$state_dir/state
notification_id_file=$state_dir/notification-id

mkdir -p "$state_dir"
chmod 0700 "$state_dir"

severity=$(
	jq -er '
		.reports as $reports
		| if .schema != "org.btrfs-headroom.report/v1"
		   or ($reports | type) != "array"
		   or ($reports | length) == 0
		then
			error("unsupported btrfs-headroom report")
		elif any(
			$reports[];
			.health.severity as $severity
			| ["ok", "unknown", "warning", "critical"]
			| index($severity) == null
		)
		then
			error("unsupported btrfs-headroom severity")
		else
			[$reports[].health.severity]
			| if index("critical") then "critical"
			  elif index("warning") then "warning"
			  elif index("unknown") then "unknown"
			  else "ok"
			  end
		end
	' "$status_file"
)

if [ "$severity" = "ok" ]; then
	body="All observed Btrfs filesystems are healthy."
	notification_key=ok
else
	body=$(
		jq -r --arg severity "$severity" '
			def byte_number:
				if . == null then null
				elif type == "number" then .
				elif type == "string" then (try tonumber catch null)
				else null
				end;
			def byte_text:
				if . >= 1073741824 then
					((((. / 1073741824) * 100 | round) / 100) | tostring) + " GiB"
				elif . >= 1048576 then
					((((. / 1048576) * 10 | round) / 10) | tostring) + " MiB"
				elif . >= 1024 then
					((((. / 1024) * 10 | round) / 10) | tostring) + " KiB"
				else
					(tostring) + " B"
				end;
			first(
				.reports[]
				| select(.health.severity == $severity)
				| . as $report
				| (
					$report.health.reasons
					| map(select(.severity == $severity))
					| .[0]
					// {
						"code": "",
						"summary": ("Health state is " + $severity)
					}
				  ) as $reason
				| ($report.observation.devices // []) as $devices
				| (
					if ($devices | length) > 0
					   and all(
						$devices[];
						(.unallocated | byte_number) != null
					   )
					then
						[$devices[].unallocated | byte_number] | add
					else
						null
					end
				  ) as $raw_unallocated
				| (
					$report.observation.space_infos // []
					| map(select(
						.kind == "metadata" or .kind == "mixed"
					  ))
					| .[0]
				  ) as $metadata
				| (
					if $metadata == null
					   or ($metadata.logical_total | byte_number) == null
					then
						null
					else
						($metadata.logical_total | byte_number) as $total
						| ([
							$metadata.logical_used,
							$metadata.bytes_may_use,
							$metadata.bytes_pinned,
							$metadata.bytes_readonly,
							$metadata.bytes_reserved,
							$metadata.bytes_zone_unusable
						  ]
						  | map(byte_number // 0)
						  | add) as $committed
						| ([($total - $committed), 0] | max)
					end
				  ) as $metadata_headroom
				| (
					$report.observation.statfs.available
					| byte_number
				  ) as $statfs_available
				| ([
					if $raw_unallocated != null
					   and $reason.code != "LOW_UNALLOCATED"
					then
						"raw unallocated " +
						($raw_unallocated | byte_text)
					else empty end,
					if $metadata_headroom != null
					then
						"metadata free in chunks " +
						($metadata_headroom | byte_text)
					else empty end,
					if $statfs_available != null
					then
						"statfs available " +
						($statfs_available | byte_text)
					else empty end
				  ] | join("; ")) as $details
				| (
					$report.observation.filesystem.mountpoints[0]
					// $report.observation.filesystem.fsid
				  ) as $filesystem
				| ($filesystem + ": " + $reason.summary) +
				  if $details == ""
				  then ""
				  else "\n" + $details
				  end
			) // ("Btrfs health is " + $severity)
		' "$status_file"
	)
	notification_key=$(
		jq -er --arg severity "$severity" '
			first(
				.reports[]
				| select(.health.severity == $severity)
				| [
					(.observation.filesystem.fsid // ""),
					(
						.health.reasons
						| map(select(.severity == $severity))
						| .[0].code // ""
					)
				  ]
				| @tsv
			) // ("health:" + $severity)
		' "$status_file"
	)
fi

digest=$(printf '%s\000%s' "$severity" "$notification_key" | sha256sum)
digest=${digest%% *}

previous_severity=
previous_digest=
if [ -r "$state_file" ]; then
	IFS=' ' read -r previous_severity previous_digest <"$state_file" || :
fi

write_state() {
	tmp=$state_file.tmp.$$
	printf '%s %s\n' "$severity" "$digest" >"$tmp"
	mv -f "$tmp" "$state_file"
}

if [ "$severity" = "$previous_severity" ] &&
	[ "$digest" = "$previous_digest" ]; then
	exit 0
fi

if [ -z "$previous_severity" ] && [ "$severity" = "ok" ]; then
	write_state
	exit 0
fi

case $severity in
critical)
	title="Btrfs headroom critical"
	urgency=critical
	icon=dialog-error
	timeout=0
	;;
warning)
	title="Btrfs headroom warning"
	urgency=normal
	icon=dialog-warning
	timeout=12000
	;;
unknown)
	title="Btrfs headroom unknown"
	urgency=normal
	icon=dialog-question
	timeout=12000
	;;
ok)
	title="Btrfs headroom recovered"
	urgency=low
	icon=drive-harddisk
	timeout=6000
	;;
esac

old_id=
if [ -r "$notification_id_file" ]; then
	IFS= read -r old_id <"$notification_id_file" || :
	case $old_id in
	'' | *[!0-9]*) old_id= ;;
	esac
fi

if [ -n "$old_id" ]; then
	new_id=$(
		notify-send --print-id --replace-id="$old_id" \
			--app-name=btrfs-headroom \
			--urgency="$urgency" \
			--expire-time="$timeout" \
			--icon="$icon" \
			"$title" "$body"
	)
else
	new_id=$(
		notify-send --print-id \
			--app-name=btrfs-headroom \
			--urgency="$urgency" \
			--expire-time="$timeout" \
			--icon="$icon" \
			"$title" "$body"
	)
fi

case $new_id in
'' | *[!0-9]*) ;;
*) printf '%s\n' "$new_id" >"$notification_id_file" ;;
esac

write_state
