# SPDX-License-Identifier: Apache-2.0 OR MIT

[Unit]
Description=Periodically inspect Btrfs allocator headroom
Documentation=https://github.com/Mr-Tao/btrfs-headroom

[Timer]
OnCalendar=*:0/5
AccuracySec=30s
RandomizedDelaySec=30s
Persistent=yes
Unit=btrfs-headroom.service

[Install]
WantedBy=timers.target
